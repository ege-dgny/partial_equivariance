<?xml version="1.0" ?>
<!-- Parametric peg with a rectangular keyway protrusion on the +X face.
     Template variables: S (side length), PH (peg height), NS (notch size). -->
<robot name="peg">
    <link name="base_link">
        <visual>
            <origin xyz="0 0 ${PH / 2}" />
            <geometry>
                <box size="${S} ${S} ${PH}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 ${PH / 2}" />
            <geometry>
                <box size="${S} ${S} ${PH}" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1" />
            <origin xyz="0 0 ${PH / 2}" />
            <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
        </inertial>
    </link>
    <link name="key">
        <visual>
            <origin xyz="0 0 0" />
            <geometry>
                <box size="${NS} ${NS} ${PH * 0.8}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" />
            <geometry>
                <box size="${NS} ${NS} ${PH * 0.8}" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01" />
            <origin xyz="0 0 0" />
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
        </inertial>
    </link>
    <joint name="key_joint" type="fixed">
        <origin xyz="${S / 2 + NS / 2} 0 ${PH / 2}" />
        <parent link="base_link" />
        <child link="key" />
    </joint>
</robot>
